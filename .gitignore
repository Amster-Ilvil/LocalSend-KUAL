# Build outputs / release archives
/build/
extension/localsend/bin/localsend-kindle
*.zip
*.tar
*.tar.gz

# Local runtime configuration (generated automatically on first run)
extension/localsend/config/settings.json

# Runtime state: never commit
extension/localsend/state/
extension/localsend/logs/
**/state/device.crt
**/state/device.key
**/state/http-fingerprint
**/state/peers.json
**/state/status.json
**/state/daemon.pid
**/state/daemon.lock
**/state/pending-install.json
**/state/install.lock
*.crt
*.key
*.pem
*.p12
*.pfx
*.p8
*.der
*.jks
*.keystore

# ZIP installer transaction data
.localsend-install-backup/
.localsend-install-stage/
*.localsend-install-*.part
*.localsend-rollback-*.part

# Transfer/runtime leftovers
*.localsend-part
*.localsend-part-*
*.log
*.log.1
*.db
*.sqlite
*.sqlite3
*.sqlite-*

# Local secrets / credentials / editor files
.env
.env.*
!.env.example
!.env.sample
!.env.template
credentials*.json
secrets*.json
service-account*.json
*.ovpn
.DS_Store
.idea/
.vscode/
